# Replace every replace-me value before use. This file contains no live credentials.

# Personal-server ingress and app origins
API_DOMAIN=api.example.com
UPLOADS_DOMAIN=uploads.example.com
CADDY_EMAIL=operator@example.com
PUBLIC_API_URL=https://api.example.com
WEB_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1
AI_FEATURES_ENABLED=true
UPLOADS_ENABLED=true
EVIDENCE_EXECUTION_ENABLED=true
PUBLIC_PROOF_PROFILE_ENABLED=true

# External Supabase PostgreSQL used by the Nest API
DATABASE_URL=postgresql://supabase_user:replace-with-password@db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\nreplace-with-supabase-root-ca\n-----END CERTIFICATE-----
DATABASE_SYNCHRONIZE=false

# Local AI PostgreSQL
POSTGRES_PASSWORD=replace-with-a-long-local-ai-database-password

# API authentication and signing secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
AI_AUTH_JWT_SECRET=replace-with-a-different-at-least-32-character-secret
VERIFICATION_CODE_SECRET=replace-with-another-at-least-32-character-secret
RATE_LIMIT_HASH_SECRET=replace-with-a-dedicated-at-least-32-character-secret

# GitHub App evidence execution
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-github-app-private-key\n-----END PRIVATE KEY-----
GITHUB_APP_WEBHOOK_SECRET=replace-with-at-least-32-character-github-webhook-secret
GITHUB_APP_SLUG=replace-with-github-app-slug
GITHUB_APP_SETUP_URL=https://github.com/apps/replace-with-github-app-slug/installations/new

# MinIO object storage
OBJECT_STORAGE_BUCKET=jagalchi-uploads
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-minio-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-minio-secret

# In-app purchase verification
IAP_ACCOUNT_BINDING_SECRET=replace-with-at-least-32-character-iap-binding-secret
GOOGLE_PLAY_PACKAGE_NAME=com.jagalchi.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"replace-with-google-cloud-project"}'

# OAuth providers
OAUTH_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
OAUTH_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
OAUTH_GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
OAUTH_APPLE_CLIENT_ID=replace-with-apple-service-id
OAUTH_APPLE_TEAM_ID=replace-with-apple-team-id
OAUTH_APPLE_KEY_ID=replace-with-apple-key-id
OAUTH_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-apple-oauth-private-key\n-----END PRIVATE KEY-----

# Transactional email
RESEND_API_KEY=re_replace-with-a-valid-resend-api-key
EMAIL_FROM="Jagalchi <no-reply@example.com>"

# AI service and external providers
DJANGO_SECRET_KEY=replace-with-a-long-django-secret-key
AI_DISABLE_EXTERNAL=false
AI_DISABLE_LLM=false
AI_AUTH_ENABLED=true
GEMINI_API_KEY=replace-with-gemini-api-key
TAVILY_API_KEY=replace-with-tavily-api-key
EXA_API_KEY=replace-with-exa-api-key

# Web build/runtime values (the web app may be hosted separately)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REALTIME_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_API_MOCKING=false
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_AI_FEATURES_ENABLED=true
NEXT_PUBLIC_EVIDENCE_EXECUTION_ENABLED=true
NEXT_PUBLIC_PROOF_PROFILE_ENABLED=true
NEXT_PUBLIC_OAUTH_ENABLED=true
API_ORIGIN=https://api.example.com
